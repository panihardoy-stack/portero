            "index": 0
          }
        ]
      ]
    },
    "Mail al administrador": {
      "main": [
        [
          {
            "node": "Marcar como avisado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Montevideo"
  },
  "pinData": {}
}
